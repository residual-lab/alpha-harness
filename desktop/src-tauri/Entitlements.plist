<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The app is signed with the hardened runtime, which keeps the camera from BRAIN's identity
       check unless asked for here; without it macOS refuses silently and never lists the app. -->
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
